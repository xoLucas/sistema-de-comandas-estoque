# PostgreSQL Connection String
# Quando usar Docker, o host deve ser 'db' (nome do serviço no docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:123456@db:5432/ladsbeer

# PostgreSQL credentials used by docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=ladsbeer
# Porta exposta no host para acesso ao PostgreSQL (desnecessária para a app,
# útil apenas para debug/backup)
POSTGRES_PORT=5433

# Aplicação
APP_HOST=0.0.0.0
APP_PORT=8000
